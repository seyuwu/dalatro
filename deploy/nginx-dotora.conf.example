# Шаблон host-nginx для dotora. Скопировать в
# /etc/nginx/sites-available/dotora, заменить <домен> на свой, затем:
#   ln -sf /etc/nginx/sites-available/dotora /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# Сертификат — certbot webroot (см. deploy/DEPLOY.md, раздел «nginx + SSL»).
# logITika и opinia живут в соседних файлах — их не трогать.

server {
    listen 80;
    server_name <домен> www.<домен>;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name <домен> www.<домен>;

    ssl_certificate     /etc/letsencrypt/live/<домен>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<домен>/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8891;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Перезапись, а не $proxy_add_x_forwarded_for (добавление): клиентский
        # заголовок подделывается, а сервер верит XFF с локальных адресов —
        # через него обходятся все IP-лимиты. Один хоп — перезапись корректна.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
